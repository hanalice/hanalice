name: Blog Sync & Mascot Rotation

on:
  schedule:
    - cron: '0 0 1 * *' # 每月1日凌晨运行
  push:
    branches:
      - main
    paths:
      - 'posts/**'
      - 'assets/mascots/**'
      - 'scripts/sync.py'
      - 'requirements.txt'
  workflow_dispatch: # 支持手动触发

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: blog-sync
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run Sync Script
        run: python scripts/sync.py

      - name: Commit via pull request
        env:
          GH_TOKEN: ${{ secrets.TRAFFIC_PAT }}
        run: |
          set -euo pipefail
          if [ -z "${GH_TOKEN}" ]; then
            echo "TRAFFIC_PAT is empty; cannot create or merge the blog-sync PR" >&2
            exit 1
          fi
          git config user.name "hanalice"
          git config user.email "hanalice@users.noreply.github.com"
          git add README.md tags/
          git add assets/mascots/ || true
          git add -f assets/mascots/daily.png 2>/dev/null || true
          git add -f assets/mascots/daily.gif 2>/dev/null || true
          if git diff --staged --quiet; then
            echo "No README/tags/mascot changes"
            exit 0
          fi
          git commit -m "chore: sync README, tags, and mascot [skip ci]"
          git push --force origin HEAD:chore/blog-sync

          existing="$(gh pr list --base main --head chore/blog-sync --state open --json number --jq '.[0].number // empty')"
          if [ -z "$existing" ]; then
            gh pr create --base main --head chore/blog-sync \
              --title "chore: sync README, tags, and mascot" \
              --body "Automated blog sync and mascot rotation. Merged by the Blog Sync workflow."
          else
            echo "Branch updated on existing PR #${existing}"
          fi

          if ! gh pr merge --squash --delete-branch=false chore/blog-sync; then
            echo "Standard merge blocked; retrying with --admin"
            gh pr merge --squash --admin --delete-branch=false chore/blog-sync
          fi
